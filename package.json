{
  "name": "gdscript-test-runner",
  "displayName": "gdscript-test-runner",
  "description": "gdUnit4 test runner for GDScript tests",
  "version": "0.0.1",
  "publisher": "polzon",
  "repository": {
    "type": "git",
    "url": "https://github.com/polzon/gd-vsc-test-runner.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/project.godot"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "GDScript Test Runner",
      "properties": {
        "gdscriptTestRunner.godotExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Godot executable. Leave empty to resolve 'godot' from PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
